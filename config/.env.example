# Copy to config/.env and fill in. NEVER commit the real .env.
# The evaluator does NOT auto-load this file — the runner must export it:
#   set -a; . config/.env; set +a

# --- Gemini (default backbone; needed for VIBE_TEACH_VLM_PROVIDER=gemini) ---
GEMINI_API_KEY=

# --- OpenAI (needed only for VIBE_TEACH_VLM_PROVIDER=gpt) ---
OPENAI_API_KEY=

# --- Anthropic (needed only for VIBE_TEACH_VLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
